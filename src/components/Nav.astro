---
import Logo from './Logo.astro';
import GithubIcon from './GithubIcon.astro';
import { NAV_ITEMS, GITHUB } from '../lib/site';

/** A nav item that is a page of its own (/videos), not an anchor on the home page, is current when we are on it. */
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href.replace(/\/$/, '') === here;
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href="/#top" aria-label="Pucksley, home">
      <Logo on="dark" height={30} />
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Sections">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class:list={[isCurrent(item.href) && 'active']} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="btn btn--sm nav-cta" href={GITHUB.project} rel="noopener"><GithubIcon size={16} /> GitHub</a>
    <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-links a')];

  /* ---- mobile menu: .nav-links becomes a panel below the bar ---- */
  const toggle = document.getElementById('navToggle');
  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')));
    links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  /* ---- the bar gets its line once the page has moved; the link for the section in view is lit ---- */
  const anchors = links.filter((a) => new URL(a.href).hash && new URL(a.href).pathname === location.pathname);
  const targets = anchors.map((a) => document.querySelector<HTMLElement>(new URL(a.href).hash));
  function onScroll() {
    nav?.classList.toggle('scrolled', scrollY > 24);
    const y = scrollY + innerHeight * 0.35;
    let current = -1;
    targets.forEach((el, i) => {
      if (el && el.getBoundingClientRect().top + scrollY <= y) current = i;
    });
    anchors.forEach((a, i) => a.classList.toggle('active', i === current));
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
